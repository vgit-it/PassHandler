<?xml version="1.0" encoding="utf-8"?>
<!--
  The "securityQa" entry-type glyph, transcribed 1:1 from the web app's
  `SecurityQaTypeIcon` (`src/ui/components/icons.tsx`) at that file's shared 24x24,
  1.8px-stroke grid (`<rect>`/`<circle>` rewritten as equivalent paths).
  Shown by `VaultKeyboardView.buildAvatar` for a non-Login entry, the same
  glyph `EntrySiteIcon` (`EntryList.tsx`) puts on that entry's plate. The
  `#E2E6EA` color is a placeholder: every call site applies its own
  `setColorFilter` (`PEG_FOREGROUND`), same as `ic_globe.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M9 9a3 3 0 1 1 4.5 2.6c-1 0.6 -1.5 1.2 -1.5 2.4"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M11.1 17.5a0.9 0.9 0 1 0 1.8 0a0.9 0.9 0 1 0 -1.8 0Z"
        android:fillColor="#E2E6EA"/>
</vector>
