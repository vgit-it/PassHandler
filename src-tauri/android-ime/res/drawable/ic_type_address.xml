<?xml version="1.0" encoding="utf-8"?>
<!--
  The "address" entry-type glyph, transcribed 1:1 from the web app's
  `AddressTypeIcon` (`src/ui/components/icons.tsx`) at that file's shared 24x24,
  1.8px-stroke grid (`<rect>`/`<circle>` rewritten as equivalent paths).
  Shown by `VaultKeyboardView.buildAvatar` for a non-Login entry, the same
  glyph `EntrySiteIcon` (`EntryList.tsx`) puts on that entry's plate. The
  `#E2E6EA` color is a placeholder: every call site applies its own
  `setColorFilter` (`PEG_FOREGROUND`), same as `ic_globe.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 21.5s7 -6.4 7 -12A7 7 0 1 0 5 9.5c0 5.6 7 12 7 12Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M9.5 9.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
