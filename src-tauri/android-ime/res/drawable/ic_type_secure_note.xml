<?xml version="1.0" encoding="utf-8"?>
<!--
  The "secureNote" entry-type glyph, transcribed 1:1 from the web app's
  `SecureNoteTypeIcon` (`src/ui/components/icons.tsx`) at that file's shared 24x24,
  1.8px-stroke grid (`<rect>`/`<circle>` rewritten as equivalent paths).
  Shown by `VaultKeyboardView.buildAvatar` for a non-Login entry, the same
  glyph `EntrySiteIcon` (`EntryList.tsx`) puts on that entry's plate. The
  `#E2E6EA` color is a placeholder: every call site applies its own
  `setColorFilter` (`PEG_FOREGROUND`), same as `ic_globe.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M6 3h9l3 3v15H6Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M15 3v3h3"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M8.5 12h7M8.5 15.5h7M8.5 8.5h4"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
