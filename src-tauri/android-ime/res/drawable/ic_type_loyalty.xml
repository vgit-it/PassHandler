<?xml version="1.0" encoding="utf-8"?>
<!--
  The "loyalty" entry-type glyph, transcribed 1:1 from the web app's
  `LoyaltyTypeIcon` (`src/ui/components/icons.tsx`) at that file's shared 24x24,
  1.8px-stroke grid (`<rect>`/`<circle>` rewritten as equivalent paths).
  Shown by `VaultKeyboardView.buildAvatar` for a non-Login entry, the same
  glyph `EntrySiteIcon` (`EntryList.tsx`) puts on that entry's plate. The
  `#E2E6EA` color is a placeholder: every call site applies its own
  `setColorFilter` (`PEG_FOREGROUND`), same as `ic_globe.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 3.5L14.4 9l6 0.9l-4.3 4.2l1 6l-5.1 -2.7l-5.1 2.7l1 -6L3.6 9.9l6 -0.9Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
