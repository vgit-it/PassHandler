<?xml version="1.0" encoding="utf-8"?>
<!--
  A globe — Login's representative icon (per request), transcribed 1:1 from
  the web app's own `GlobeIcon` (`src/ui/components/icons.tsx`): a circle,
  an equator line, and one meridian lens shape, all at the shared 24×24,
  1.8px-stroke grid every icon in that file uses. Used by
  `VaultKeyboardView.buildAvatar` on a Login entry's plate whenever no
  favicon is available for it, matching what the web app's own entry list
  shows in the same case (`EntryList.tsx`'s `EntrySiteIcon`). Also
  `entryTypeIconRes`'s fallback for a type id the IME doesn't know, same as
  `entryTypeIcons.tsx`. Other types use their own `ic_type_*.xml` glyph.

  Unlike `ic_lock.xml`, the baked-in `#E2E6EA` stroke color below is only a
  placeholder, not the real one: every call site applies its own
  `setColorFilter` at render time (`buildAvatar` tints it `PEG_FOREGROUND`,
  the neutral plate's light glyph colour, mirroring `EntryList.tsx`'s
  `pegForeground`).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2 12A10 10 0 1 0 22 12A10 10 0 1 0 2 12"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M2 12h20"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
    <path
        android:pathData="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
