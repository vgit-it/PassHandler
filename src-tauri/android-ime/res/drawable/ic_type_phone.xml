<?xml version="1.0" encoding="utf-8"?>
<!--
  The "phone" entry-type glyph, transcribed 1:1 from the web app's
  `PhoneTypeIcon` (`src/ui/components/icons.tsx`) at that file's shared 24x24,
  1.8px-stroke grid (`<rect>`/`<circle>` rewritten as equivalent paths).
  Shown by `VaultKeyboardView.buildAvatar` for a non-Login entry, the same
  glyph `EntrySiteIcon` (`EntryList.tsx`) puts on that entry's plate. The
  `#E2E6EA` color is a placeholder: every call site applies its own
  `setColorFilter` (`PEG_FOREGROUND`), same as `ic_globe.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M6.5 3.5h3l1.3 4l-2 1.4a11 11 0 0 0 5.3 5.3l1.4 -2l4 1.3v3a2 2 0 0 1 -2.2 2A17.5 17.5 0 0 1 4.5 5.7a2 2 0 0 1 2 -2.2Z"
        android:strokeColor="#E2E6EA"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>
</vector>
