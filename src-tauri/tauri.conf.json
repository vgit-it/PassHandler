{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pass Handler",
  "version": "1.0.0",
  "identifier": "com.passhandler.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pass Handler",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Pass Handler",
    "shortDescription": "KeePass-compatible password manager",
    "longDescription": "A personal password manager using the KeePass .kdbx format, with optional Google Drive sync of the encrypted vault.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
