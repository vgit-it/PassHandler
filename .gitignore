node_modules/
dist/
*.local

# Environment — holds the per-platform Google OAuth client IDs.
# Never commit. See .env.example and docs/google-oauth-setup.md.
.env
.env.*
!.env.example

# Rust / Tauri
src-tauri/target/
src-tauri/plugins/*/target/

# Generated by `tauri android init` / `tauri ios init` on a machine with the
# platform SDK installed. Not reproducible in CI without the Android SDK.
src-tauri/gen/

# Android signing material. Losing the release keystore means never being able
# to sign an update to the same app identity again — back it up off-repo.
*.keystore
*.jks
keystore.properties

# Vault artefacts must never reach the repository.
*.kdbx
*.kdbx.bak
*.kdbx.tmp

.DS_Store
Thumbs.db
.vscode/
.idea/
